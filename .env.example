# =============================================================================
# AppSec Scout — Docker Compose environment
# =============================================================================
# Copy this file to .env and fill in your values.
# This file is read by Docker Compose ONLY — it is NOT the Laravel app config.
# Laravel configuration lives in app-laravel/.env (see app-laravel/.env.example).
# =============================================================================

# ---------------------------------------------------------------------------
# App container port
# Host port the app is exposed on. Change if 8080 is already in use.
# ---------------------------------------------------------------------------
APP_PORT=8080

# ---------------------------------------------------------------------------
# Database credentials (MySQL container by default; PostgreSQL when the
# docker-compose.pgsql.yml override is active — see "Database engine" below)
# DB_DATABASE / DB_USERNAME / DB_PASSWORD must exactly match the values in
# app-laravel/.env so that the app can connect to the database the database
# container initialised. Both engines share these three variables.
# DB_ROOT_PASSWORD is used only by the mysql container — not by the Laravel app.
# ---------------------------------------------------------------------------
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=appsec_scout
DB_USERNAME=appsec_scout
DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Database engine (default: MySQL 8 — leave as-is for the unchanged local setup)
# To run the stack on PostgreSQL 16 instead, uncomment the COMPOSE_FILE line
# below: every `docker compose` invocation (the PowerShell scripts included)
# then layers docker-compose.pgsql.yml on top of docker-compose.yml, which
# starts a `postgres` service instead of `mysql` and repoints the app at it.
# The `;` separator is Docker Compose's default path separator on Windows; on
# Linux/macOS use `:` (or set COMPOSE_PATH_SEPARATOR to match).
# NOTE: switching engines starts from an empty database — data is NOT migrated
# between mysql_data and postgres_data volumes (both survive the switch).
# ---------------------------------------------------------------------------
#COMPOSE_FILE=docker-compose.yml;docker-compose.pgsql.yml

# ---------------------------------------------------------------------------
# Prebuilt images (default: build locally — leave as-is for development)
# To run the stack from the images CI publishes to the GitHub Container
# Registry (Trivy-gated, no local build toolchain needed), uncomment the
# COMPOSE_FILE line below: every `docker compose` invocation (the PowerShell
# scripts included) then layers docker-compose.ghcr.yml on top of
# docker-compose.yml — see that file's header for exactly what changes.
# APPSEC_IMAGE_TAG selects the image tag (default: latest); deployments
# should pin an immutable sha-<short-commit> tag instead of tracking latest.
# To combine with the PostgreSQL engine, list all three files, e.g.:
#   COMPOSE_FILE=docker-compose.yml;docker-compose.pgsql.yml;docker-compose.ghcr.yml
# ---------------------------------------------------------------------------
#COMPOSE_FILE=docker-compose.yml;docker-compose.ghcr.yml
#APPSEC_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Corporate proxy and custom TLS (leave empty for direct internet access)
# These are the single source of truth for every container in the stack —
# app, mysql, redis, dependencytrack, and ops all read them from here.
# invoke-ops.ps1 layers docker/ops/.env on top of this file; do not repeat
# these values there.
# NO_PROXY: comma-separated hosts to bypass (e.g. localhost,127.0.0.1,mysql,redis).
# SSL_CERT_FILE: path to a custom CA bundle for TLS-intercepting proxies.
#   Populated automatically from the Windows cert store by:
#   .\scripts\appsec-scout.ps1 -Rebuild
# ---------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
SSL_CERT_FILE=

# ---------------------------------------------------------------------------
# Opengrep (static analysis) install toggle
# Both the `ops` and `static-analysis-collector` images download a pinned Opengrep
# binary + ruleset from GitHub releases at build time. Set to "false" where corporate
# network/DLP policy (e.g. Netskope) blocks that binary download — the build then skips
# it entirely, and both collect-static-analysis.sh (ops) and AnalyzeRepositoryJob
# (static-analysis-collector) automatically stop invoking Opengrep, running only the
# .NET/Java analyzers instead.
# ---------------------------------------------------------------------------
OPENGREP_ENABLED=true

# ---------------------------------------------------------------------------
# OWASP Dependency-Track (SBOM visualization) + bundled Trivy analyzer server
# Both start automatically with the rest of the stack — not an opt-in profile.
# The dependencytrack-bootstrap one-shot container automatically logs in as
# DTRACK_ADMIN_USERNAME/DTRACK_ADMIN_PASSWORD (performing the forced first-boot
# password change if needed), grants the Automation team the permissions needed
# for BOM uploads, stores a fresh API key in AppSec Scout's credential vault,
# and configures Dependency-Track's Trivy analyzer — no manual API key,
# permission, or token setup. The shared secret between trivy-server and
# Dependency-Track is generated once inside the stack (a trivy-token-init
# container writes it to a Docker volume both containers read) — there is
# nothing to configure for it here.
# Frontend: http://localhost:8090
# API:      http://localhost:8091 (externally) / DTRACK_INTERNAL_BASE_URL (container-to-container)
# ---------------------------------------------------------------------------
DTRACK_DB_DATABASE=dtrack
DTRACK_DB_USERNAME=dtrack
DTRACK_DB_PASSWORD=dtrack
DTRACK_API_PORT=8091
DTRACK_FRONTEND_PORT=8090
DTRACK_API_BASE_URL=http://localhost:8091
DTRACK_INTERNAL_BASE_URL=http://dependencytrack-apiserver:8080
DTRACK_ADMIN_USERNAME=admin
DTRACK_ADMIN_PASSWORD=admin
DTRACK_TEAM=Automation
# JVM heap cap for dependencytrack-apiserver and the container memory limit it runs under.
# Lower both on hosts where Docker itself has a small memory allocation (e.g. a constrained
# corporate Docker Desktop/WSL2 config) to avoid the apiserver being silently OOM-killed.
DTRACK_JAVA_MAX_HEAP=4g
DTRACK_MEM_LIMIT=5g
DTRACK_CPUS=2

# trivy-server's base URL, shared by Dependency-Track's Trivy analyzer config and by
# the ops container's org-wide scans (both use the same self-hosted vulnerability
# database instead of downloading their own). Not exposed on the host; container-to-
# container only.
TRIVY_SERVER_URL=http://trivy-server:4954

# ---------------------------------------------------------------------------
# Container resource limits (CPU count and memory, per container).
# Defaults assume a host with generous headroom (e.g. 16 vCPU). On a more
# constrained host — a locked-down corporate Docker Desktop/WSL2 allocation in
# particular — sustained high CPU usage across these containers (trivy-server
# and dependencytrack-apiserver during sbom-scan runs, above all) can starve
# Docker Desktop's own engine API, causing intermittent HTTP 500s / "unexpected
# EOF" from the docker CLI even though every container still shows "Up". Lower
# these to leave headroom for the engine's control plane and the host itself.
# ---------------------------------------------------------------------------
MYSQL_CPUS=1
MYSQL_MEM_LIMIT=1g
POSTGRES_CPUS=1
POSTGRES_MEM_LIMIT=1g
DTRACK_DB_CPUS=1
DTRACK_DB_MEM_LIMIT=1g
TRIVY_CPUS=2
TRIVY_MEM_LIMIT=3g
OPS_CPUS=2
OPS_MEM_LIMIT=2g

# ---------------------------------------------------------------------------
# The ops container (invoke-ops.ps1 — shell, Claude Code, and SBOM scans alike)
# additionally uses its own env file, layered on top of this one (proxy/TLS
# settings above still apply):
#   docker/ops/.env.example  →  docker/ops/.env
# Its AzDO/GitHub PATs are also unnecessary in the common case: invoke-ops.ps1
# reuses the credentials already stored in appsec-scout's own credential vault
# (Settings > Integrations) via the running `app` container.
# ---------------------------------------------------------------------------
